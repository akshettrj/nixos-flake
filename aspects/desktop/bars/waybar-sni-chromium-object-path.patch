Split the "<bus name><object path>" service string that
org.kde.StatusNotifierWatcher.RegisterStatusNotifierItem accepts.

Chromium-based clients (every Electron app, e.g. the Mullvad VPN GUI) do not
use the default /StatusNotifierItem object path: they export the item at
/StatusNotifierItem/<n> and register it as the bus name and the object path
concatenated, e.g.

    org.freedesktop.StatusNotifierItem-1234-1/StatusNotifierItem/1

Waybar's watcher takes the whole string as a bus name, fails g_dbus_is_name()
and answers InvalidArgs, so those tray icons never appear.
Host::getBusNameAndObjectPath() already splits the same form on the receiving
side, so only the watcher needs teaching.

--- a/src/modules/sni/watcher.cpp
+++ b/src/modules/sni/watcher.cpp
@@ -2,6 +2,9 @@
 
 #include <spdlog/spdlog.h>
 
+#include <cstring>
+#include <string>
+
 #include "util/scope_guard.hpp"
 
 using namespace waybar::modules::SNI;
@@ -87,10 +90,19 @@
                                      const gchar* service) {
   const gchar* bus_name = service;
   const gchar* object_path = "/StatusNotifierItem";
+  std::string bus_name_storage;
 
   if (*service == '/') {
     bus_name = g_dbus_method_invocation_get_sender(invocation);
     object_path = service;
+  } else if (const gchar* separator = std::strchr(service, '/'); separator != nullptr) {
+    // Chromium-based clients (Electron apps) do not export the item at the
+    // default /StatusNotifierItem path, and register it as the bus name and
+    // the object path concatenated. Keep the bus name copy alive for as long
+    // as the borrowed `bus_name` pointer below is used.
+    bus_name_storage.assign(service, separator - service);
+    bus_name = bus_name_storage.c_str();
+    object_path = separator;
   }
   if (g_dbus_is_name(bus_name) == FALSE) {
     g_dbus_method_invocation_return_error(invocation, G_DBUS_ERROR, G_DBUS_ERROR_INVALID_ARGS,
