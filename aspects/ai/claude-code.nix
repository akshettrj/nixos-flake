{
    config,
    lib,
    pkgs,
    ...
}:
{
    config =
        let
            biryani_ai = config.biryani.programs.ai;
            biryani_claude_code = biryani_ai.claude-code;

            # claude writes to settings.json at runtime (`/model`, permission
            # grants, plugin toggles, ...).
            claudeSettingsFile = "${config.programs.claude-code.configDir}/settings.json";
            mutableConfig = import ./mutable-config.nix { inherit lib pkgs; };

            # Generated by Statusline Studio; kept verbatim so it can be
            # regenerated and dropped in as-is.
            statusline = pkgs.writeShellApplication {
                name = "claude-statusline";
                runtimeInputs = with pkgs; [
                    coreutils
                    gawk
                    git
                    jq
                ];
                # The generated script relies on unset vars and failing
                # commands being non-fatal, and isn't shellcheck-clean.
                bashOptions = [ ];
                checkPhase = "";
                text = builtins.readFile ./claude-statusline.sh;
            };
        in
        lib.mkIf (biryani_ai.enable && biryani_claude_code.enable) (
            lib.mkMerge [
                {
                    programs.claude-code = {
                        enable = true;
                        package = pkgs.llm-agents.claude-code;
                        enableMcpIntegration = true;
                        # configDir = "${config.xdg.configHome}/claude";
                        skills = biryani_ai.skills;
                        context = ''
                            - On every iteration, send the user a concise list of next steps, including progress updates and the final response.
                            - Other than MPVs, ensure that the code generated is scalable, maintainable and easily extensible.
                        '';
                        mcpServers = lib.mkIf (biryani_claude_code.mcpServers != null) biryani_claude_code.mcpServers;
                        settings = {
                            theme = "auto";
                            model = "claude-opus-5[1m]";
                            effortLevel = "high";
                            editorMode = "vim";
                            includeCoAuthoredBy = false;
                            enabledPlugins = {
                                "lua-lsp@claude-plugins-official" = true;
                                "gopls-lsp@claude-plugins-official" = true;
                                "rust-analyzer-lsp@claude-plugins-official" = true;
                                "frontend-design@claude-plugins-official" = true;
                                "mattpocock-skills@claude-plugins-official" = true;
                                "codex@openai-codex" = true;
                            };
                            extraKnownMarketplaces = {
                                openai-codex.source = {
                                    source = "github";
                                    repo = "openai/codex-plugin-cc";
                                };
                            };
                            statusLine = {
                                type = "command";
                                command = lib.getExe statusline;
                                padding = 0;
                            };
                        };
                    };

                    home.packages = [ pkgs.nodejs ];
                }
                (mutableConfig.mkMutableConfig {
                    name = "claudeCode";
                    format = "json";
                    fileKey = claudeSettingsFile;
                    managedSource = config.home.file.${claudeSettingsFile}.source;
                    targetPath = claudeSettingsFile;
                })
            ]
        );
}
